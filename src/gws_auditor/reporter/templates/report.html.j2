      <div class="tab-content tab-content--hidden" id="tab-inv-chat"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: Stale Mobile (ADD-30) ==================== -->
      {% if "ADD-30" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-mobile"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: Stale ChromeOS (ADD-31) ==================== -->
      {% if "ADD-31" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-chromeos"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: 2SV Enrollment (ADD-32) ==================== -->
      {% if "ADD-32" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-2sv"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: OAuth Risk (ADD-33) ==================== -->
      {% if "ADD-33" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-oauth"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: App Passwords (ADD-34) ==================== -->
      {% if "ADD-34" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-asps"><div class="inv-main"></div></div>
      {% endif %}

      <!-- ==================== Tab: Shared Drives (ADD-35) ==================== -->
      {% if "ADD-35" in inventory %}
      <div class="tab-content tab-content--hidden" id="tab-inv-drives"><div class="inv-main"></div></div>
      {% endif %}

      <!-- Inventory data for JS rendering -->
      <script id="inventoryData" type="application/json">{{ inventory | tojson_safe }}</script>

      <footer>
        Generated by <strong>GWS Security Auditor</strong> on {{ timestamp }}
      </footer>
    </div>
  </div>

  <!-- Detail Modal -->
  <div class="modal-overlay" id="detailModal">
    <div class="modal-card">
      <button class="modal-close" id="modalClose">&times;</button>
      <div class="modal-header">
        <h3 id="modal-check-id"></h3>
        <span id="modal-source" class="source-tag"></span>
      </div>
      <div id="modal-title" style="font-size:1rem;margin-bottom:0.75rem;"></div>
      <div class="modal-meta">
        <span id="modal-status-wrap"></span>
        <span><strong>Level:</strong> <span id="modal-level"></span></span>
        <span><strong>Section:</strong> <span id="modal-section"></span></span>
      </div>
      <div class="modal-section"><div class="modal-section-label">Details</div><div class="modal-section-content" id="modal-details"></div></div>
      <div class="modal-section"><div class="modal-section-label">Actual Value</div><div class="modal-section-content" id="modal-actual"></div></div>
      <div class="modal-section"><div class="modal-section-label">Expected Value</div><div class="modal-section-content" id="modal-expected"></div></div>
      <div class="modal-section"><div class="modal-section-label">Org Unit</div><div class="modal-section-content" id="modal-org-unit"></div></div>
      <div class="modal-section"><div class="modal-section-label">Remediation</div><div class="modal-section-content" id="modal-remediation"></div></div>
    </div>
  </div>

  <!-- Back to Top -->
  <button class="back-to-top" id="backToTop" aria-label="Back to top">&#8593;</button>

  <!-- ==================== JavaScript ==================== -->
  <script>
    (function() {
      'use strict';

      /* ---------- Theme toggle ---------- */
      var html = document.documentElement;
      var themeBtn = document.getElementById('themeToggle');
      var iconSun = themeBtn.querySelector('.icon-sun');
      var iconMoon = themeBtn.querySelector('.icon-moon');

      function applyTheme(theme) {
        html.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          iconSun.style.display = 'none';
          iconMoon.style.display = 'block';
        } else {
          iconSun.style.display = 'block';
          iconMoon.style.display = 'none';
        }
      }

      var saved = localStorage.getItem('gws-theme');
      if (saved) {
        applyTheme(saved);
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        applyTheme('dark');
      }

      themeBtn.addEventListener('click', function() {
        var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        localStorage.setItem('gws-theme', next);
      });

      /* ---------- TOC sidebar toggle (mobile) ---------- */
      var tocToggle = document.getElementById('tocToggle');
      var tocSidebar = document.getElementById('tocSidebar');
      tocToggle.addEventListener('click', function() {
        tocSidebar.classList.toggle('open');
      });
      /* Close sidebar when clicking a link on mobile */
      tocSidebar.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', function() {
          if (window.innerWidth < 1024) tocSidebar.classList.remove('open');
        });
      });

      /* ---------- TOC active highlight (IntersectionObserver) ---------- */
      var sectionBlocks = document.querySelectorAll('.section-block');
      var tocLinks = tocSidebar.querySelectorAll('a');
      if (sectionBlocks.length && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var id = entry.target.id;
              tocLinks.forEach(function(l) {
                l.classList.toggle('active', l.getAttribute('href') === '#' + id);
              });
            }
          });
        }, { rootMargin: '-10% 0px -80% 0px' });
        sectionBlocks.forEach(function(s) { observer.observe(s); });
      }

      /* ---------- Section collapse / expand ---------- */
      window.toggleSection = function(header) {
        header.classList.toggle('collapsed');
        header.parentElement.querySelector('.section-body').classList.toggle('hidden');
      };

      document.getElementById('expandAllBtn').addEventListener('click', function() {
        document.querySelectorAll('.section-header').forEach(function(h) {
          h.classList.remove('collapsed');
        });
        document.querySelectorAll('.section-body').forEach(function(b) {
          b.classList.remove('hidden');
        });
      });

      document.getElementById('collapseAllBtn').addEventListener('click', function() {
        document.querySelectorAll('.section-header').forEach(function(h) {
          h.classList.add('collapsed');
        });
        document.querySelectorAll('.section-body').forEach(function(b) {
          b.classList.add('hidden');
        });
      });

      /* ---------- Status filtering + search + OU filtering ---------- */
      var currentFilter = 'ALL';
      var currentSearch = '';
      var currentOU = '';
      var allRows = document.querySelectorAll('.check-row');
      var searchInput = document.getElementById('searchInput');
      var searchCount = document.getElementById('searchCount');
      var ouFilter = document.getElementById('ouFilter');

      /* Determine the effective status of a row given the current OU filter */
      function getEffectiveStatus(row) {
        var original = row.getAttribute('data-status');
        if (!currentOU) return original;
        var ouFails = row.getAttribute('data-ou-fails');
        /* Non-OU-aware check (no data) -> keep original */
        if (!ouFails) return original;
        /* Only recalculate PASS/FAIL; other statuses stay as-is */
        if (original !== 'PASS' && original !== 'FAIL') return original;
        /* Originally PASS means all OUs are fine */
        if (original === 'PASS') return 'PASS';
        /* Originally FAIL -> check if selected OU is in the fail list */
        try {
          var failOUs = JSON.parse(ouFails);
          return failOUs.indexOf(currentOU) !== -1 ? 'FAIL' : 'PASS';
        } catch(e) {
          return original;
        }
      }

      /* Map status string to badge CSS class suffix */
      var badgeClasses = {
        'PASS': 'badge--PASS', 'FAIL': 'badge--FAIL', 'WARN': 'badge--WARN',
        'ERROR': 'badge--ERROR', 'MANUAL': 'badge--MANUAL', 'NOT_APPLICABLE': 'badge--NOT_APPLICABLE'
      };
      var badgeLabels = {
        'PASS': 'PASS', 'FAIL': 'FAIL', 'WARN': 'WARN',
        'ERROR': 'ERROR', 'MANUAL': 'MANUAL', 'NOT_APPLICABLE': 'NOT APPLICABLE'
      };

      function updateSummary(counts) {
        var total = counts.PASS + counts.FAIL + counts.WARN + counts.ERROR + counts.MANUAL + counts.NOT_APPLICABLE;
        var evaluated = counts.PASS + counts.FAIL;
        var passRate = evaluated > 0 ? (counts.PASS / evaluated * 100) : 0;

        /* Update summary cards */
        var el;
        el = document.getElementById('card-total'); if (el) el.textContent = total;
        el = document.getElementById('card-pass'); if (el) el.textContent = counts.PASS;
        el = document.getElementById('card-fail'); if (el) el.textContent = counts.FAIL;
        el = document.getElementById('card-warn'); if (el) el.textContent = counts.WARN;
        el = document.getElementById('card-error'); if (el) el.textContent = counts.ERROR;
        el = document.getElementById('card-manual'); if (el) el.textContent = counts.MANUAL;
        el = document.getElementById('card-na'); if (el) el.textContent = counts.NOT_APPLICABLE;
        el = document.getElementById('card-rate'); if (el) el.textContent = passRate.toFixed(1) + '%';

        /* Update proportion bars */
        if (total > 0) {
          el = document.getElementById('bar-pass'); if (el) el.style.width = (counts.PASS / total * 100).toFixed(1) + '%';
          el = document.getElementById('bar-fail'); if (el) el.style.width = (counts.FAIL / total * 100).toFixed(1) + '%';
          el = document.getElementById('bar-warn'); if (el) el.style.width = (counts.WARN / total * 100).toFixed(1) + '%';
          el = document.getElementById('bar-error'); if (el) el.style.width = (counts.ERROR / total * 100).toFixed(1) + '%';
          el = document.getElementById('bar-manual'); if (el) el.style.width = (counts.MANUAL / total * 100).toFixed(1) + '%';
          el = document.getElementById('bar-na'); if (el) el.style.width = (counts.NOT_APPLICABLE / total * 100).toFixed(1) + '%';
        }

        /* Update filter button counts */
        document.querySelectorAll('.filter-btn').forEach(function(btn) {
          var f = btn.getAttribute('data-filter');
          var countEl = btn.querySelector('.filter-count');
          if (!countEl) return;
          if (f === 'ALL') countEl.textContent = total;
          else if (counts[f] !== undefined) countEl.textContent = counts[f];
        });

        /* Update legend labels */
        el = document.getElementById('legend-pass'); if (el) el.textContent = 'Pass (' + counts.PASS + ')';
        el = document.getElementById('legend-fail'); if (el) el.textContent = 'Fail (' + counts.FAIL + ')';
        el = document.getElementById('legend-warn'); if (el) el.textContent = 'Warn (' + counts.WARN + ')';
        el = document.getElementById('legend-error'); if (el) el.textContent = 'Error (' + counts.ERROR + ')';
        el = document.getElementById('legend-manual'); if (el) el.textContent = 'Manual (' + counts.MANUAL + ')';
        el = document.getElementById('legend-na'); if (el) el.textContent = 'N/A (' + counts.NOT_APPLICABLE + ')';

        /* Rebuild stacked bar chart SVG */
        var barSvg = document.getElementById('bar-chart-svg');
        if (barSvg && total > 0) {
          var segs = [
            { pct: counts.PASS / total * 100, color: '#38a169' },
            { pct: counts.FAIL / total * 100, color: '#e53e3e' },
            { pct: counts.WARN / total * 100, color: '#d69e2e' },
            { pct: counts.ERROR / total * 100, color: '#9b2c2c' },
            { pct: counts.MANUAL / total * 100, color: '#3182ce' },
            { pct: counts.NOT_APPLICABLE / total * 100, color: '#a0aec0' }
          ];
          var svgContent = '';
          var xPos = 0;
          var isFirst = true;
          for (var i = 0; i < segs.length; i++) {
            if (segs[i].pct > 0) {
              var w = segs[i].pct * 10;
              var rx = isFirst ? ' rx="4"' : '';
              svgContent += '<rect x="' + xPos + '" y="0" width="' + w + '" height="40" fill="' + segs[i].color + '"' + rx + '/>';
              if (segs[i].pct > 8) {
                svgContent += '<text x="' + (xPos + w / 2) + '" y="24" text-anchor="middle" fill="#fff" font-size="13" font-weight="600" font-family="-apple-system,sans-serif">' + Math.round(segs[i].pct) + '%</text>';
              }
              xPos += w;
              isFirst = false;
            }
          }
          barSvg.innerHTML = svgContent;
        }

        /* Rebuild donut chart */
        var donutChart = document.getElementById('donut-chart');
        if (donutChart && total > 0) {
          var circumference = 502.65;
          var donutSegs = [
            { count: counts.PASS, color: '#38a169' },
            { count: counts.FAIL, color: '#e53e3e' },
            { count: counts.WARN, color: '#d69e2e' },
            { count: counts.ERROR, color: '#9b2c2c' },
            { count: counts.MANUAL, color: '#3182ce' },
            { count: counts.NOT_APPLICABLE, color: '#a0aec0' }
          ];
          var donutSvgContent = '<circle cx="90" cy="90" r="80" fill="none" stroke="var(--color-border-light)" stroke-width="18"/>';
          var offset = 0;
          for (var j = 0; j < donutSegs.length; j++) {
            if (donutSegs[j].count > 0) {
              var segLen = (donutSegs[j].count / total) * circumference;
              donutSvgContent += '<circle cx="90" cy="90" r="80" fill="none" stroke="' + donutSegs[j].color + '" stroke-width="18" stroke-dasharray="' + segLen + ' ' + (circumference - segLen) + '" stroke-dashoffset="' + (-offset) + '" stroke-linecap="butt"/>';
              offset += segLen;
            }
          }
          var svgEl = donutChart.querySelector('svg');
          if (svgEl) svgEl.innerHTML = donutSvgContent;
        }
        el = document.getElementById('donut-rate'); if (el) el.textContent = Math.round(passRate) + '%';
      }

      function updateSectionSummaries() {
        document.querySelectorAll('.section-block').forEach(function(block) {
          var rows = block.querySelectorAll('.check-row');
          var secCounts = { PASS: 0, FAIL: 0, WARN: 0, ERROR: 0, MANUAL: 0, NOT_APPLICABLE: 0 };
          rows.forEach(function(r) {
            var s = getEffectiveStatus(r);
            if (secCounts[s] !== undefined) secCounts[s]++;
          });
          var secTotal = rows.length;

          /* Update section header badges */
          var statsEl = block.querySelector('.section-stats');
          if (statsEl) {
            var badgeHtml = '';
            if (secCounts.PASS > 0) badgeHtml += '<span class="section-stat section-stat--pass">' + secCounts.PASS + ' pass</span>';
            if (secCounts.FAIL > 0) badgeHtml += '<span class="section-stat section-stat--fail">' + secCounts.FAIL + ' fail</span>';
            if (secCounts.WARN > 0) badgeHtml += '<span class="section-stat section-stat--warn">' + secCounts.WARN + ' warn</span>';
            if (secCounts.ERROR > 0) badgeHtml += '<span class="section-stat section-stat--error">' + secCounts.ERROR + ' err</span>';
            if (secCounts.MANUAL > 0) badgeHtml += '<span class="section-stat section-stat--manual">' + secCounts.MANUAL + ' manual</span>';
            statsEl.innerHTML = badgeHtml;
          }

          /* Update section status bar */
          var statusBar = block.querySelector('.section-status-bar');
          if (statusBar && secTotal > 0) {
            var barHtml = '';
            var secNA = secTotal - secCounts.PASS - secCounts.FAIL - secCounts.WARN - secCounts.ERROR - secCounts.MANUAL;
            if (secCounts.PASS > 0) barHtml += '<span style="width:' + (secCounts.PASS / secTotal * 100).toFixed(1) + '%;background:var(--color-pass)"></span>';
            if (secCounts.FAIL > 0) barHtml += '<span style="width:' + (secCounts.FAIL / secTotal * 100).toFixed(1) + '%;background:var(--color-fail)"></span>';
            if (secCounts.WARN > 0) barHtml += '<span style="width:' + (secCounts.WARN / secTotal * 100).toFixed(1) + '%;background:var(--color-warn)"></span>';
            if (secCounts.ERROR > 0) barHtml += '<span style="width:' + (secCounts.ERROR / secTotal * 100).toFixed(1) + '%;background:var(--color-error)"></span>';
            if (secCounts.MANUAL > 0) barHtml += '<span style="width:' + (secCounts.MANUAL / secTotal * 100).toFixed(1) + '%;background:var(--color-manual)"></span>';
            if (secNA > 0) barHtml += '<span style="width:' + (secNA / secTotal * 100).toFixed(1) + '%;background:var(--color-na)"></span>';
            statusBar.innerHTML = barHtml;
          }
        });

        /* Update TOC sidebar badges */
        var tocLinks = document.querySelectorAll('#tocSidebar a[data-toc-idx]');
        tocLinks.forEach(function(link) {
          var idx = link.getAttribute('data-toc-idx');
          var section = document.getElementById('section-' + idx);
          if (!section) return;
          var rows = section.querySelectorAll('.check-row');
          var failCount = 0;
          rows.forEach(function(r) { if (getEffectiveStatus(r) === 'FAIL') failCount++; });
          var badge = link.querySelector('.toc-badge');
          if (failCount > 0) {
            if (!badge) {
              badge = document.createElement('span');
              badge.className = 'toc-badge';
              link.appendChild(badge);
            }
            badge.textContent = failCount;
          } else if (badge) {
            badge.remove();
          }
        });
      }

      function applyFilters() {
        var visibleCount = 0;
        var counts = { PASS: 0, FAIL: 0, WARN: 0, ERROR: 0, MANUAL: 0, NOT_APPLICABLE: 0 };

        allRows.forEach(function(row) {
          var effectiveStatus = getEffectiveStatus(row);

          /* Update the badge element to reflect effective status */
          var badge = row.querySelector('.badge');
          if (badge) {
            badge.className = 'badge ' + (badgeClasses[effectiveStatus] || '');
            badge.textContent = badgeLabels[effectiveStatus] || effectiveStatus;
          }

          var statusMatch = (currentFilter === 'ALL' || effectiveStatus === currentFilter);
          var searchMatch = (!currentSearch || row.textContent.toLowerCase().indexOf(currentSearch) !== -1);
          var visible = statusMatch && searchMatch;
          row.style.display = visible ? '' : 'none';
          if (visible) visibleCount++;

          /* Accumulate counts using effective status */
          if (counts[effectiveStatus] !== undefined) counts[effectiveStatus]++;
        });

        /* Hide sections where all rows hidden */
        document.querySelectorAll('.section-block').forEach(function(block) {
          var rows = block.querySelectorAll('.check-row');
          var any = false;
          rows.forEach(function(r) { if (r.style.display !== 'none') any = true; });
          block.style.display = any ? '' : 'none';
        });

        /* Update search count */
        if (currentSearch) {
          searchCount.textContent = visibleCount + ' match' + (visibleCount !== 1 ? 'es' : '');
        } else {
          searchCount.textContent = '';
        }

        /* Update all summary elements */
        updateSummary(counts);
        updateSectionSummaries();
      }

      document.querySelectorAll('.filter-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          currentFilter = btn.getAttribute('data-filter');
          applyFilters();
        });
      });

      searchInput.addEventListener('input', function() {
        currentSearch = searchInput.value.trim().toLowerCase();
        applyFilters();
      });

      /* OU filter change handler */
      if (ouFilter) {
        ouFilter.addEventListener('change', function() {
          currentOU = ouFilter.value;
          applyFilters();
        });
      }

      /* ---------- Column sorting ---------- */
      var statusOrder = { 'FAIL': 0, 'ERROR': 1, 'WARN': 2, 'MANUAL': 3, 'PASS': 4, 'NOT_APPLICABLE': 5 };
      document.querySelectorAll('thead th[data-col]').forEach(function(th) {
        if (th.getAttribute('data-col') === 'details' || th.getAttribute('data-col') === 'remediation') return;
        th.addEventListener('click', function() {
          var table = th.closest('table');
          var tbody = table.querySelector('tbody');
          var colIdx = Array.prototype.indexOf.call(th.parentNode.children, th);
          var col = th.getAttribute('data-col');
          var asc = !th.classList.contains('sorted') || th.classList.contains('sort-desc');

          /* Reset other th in same table */
          th.parentNode.querySelectorAll('th').forEach(function(h) {
            h.classList.remove('sorted', 'sort-asc', 'sort-desc');
          });
          th.classList.add('sorted', asc ? 'sort-asc' : 'sort-desc');
          th.querySelector('.sort-icon').textContent = asc ? '\u25B2' : '\u25BC';

          var rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort(function(a, b) {
            var aVal, bVal;
            if (col === 'status') {
              aVal = statusOrder[a.getAttribute('data-status')] || 99;
              bVal = statusOrder[b.getAttribute('data-status')] || 99;
            } else {
              aVal = (a.children[colIdx] ? a.children[colIdx].textContent.trim().toLowerCase() : '');
              bVal = (b.children[colIdx] ? b.children[colIdx].textContent.trim().toLowerCase() : '');
            }
            if (aVal < bVal) return asc ? -1 : 1;
            if (aVal > bVal) return asc ? 1 : -1;
            return 0;
          });
          rows.forEach(function(r) { tbody.appendChild(r); });
        });
      });

      /* ---------- Column visibility toggles ---------- */
      function toggleColumn(cls, visible) {
        document.querySelectorAll('.' + cls).forEach(function(el) {
          el.style.display = visible ? '' : 'none';
        });
      }
      document.getElementById('colLevel').addEventListener('change', function() {
        toggleColumn('col-level', this.checked);
      });
      document.getElementById('colRemediation').addEventListener('change', function() {
        toggleColumn('col-remediation', this.checked);
      });

      /* ---------- Tab switching ---------- */
      var tabBtns = document.querySelectorAll('.tab-btn[data-tab]');
      var tabPanels = document.querySelectorAll('.tab-content');
      var layoutEl = document.querySelector('.layout');
      var renderedTabs = {};

      function switchTab(tabId) {
        tabBtns.forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-tab') === tabId); });
        tabPanels.forEach(function(p) { p.classList.toggle('tab-content--hidden', p.id !== tabId); });
        var isInv = tabId !== 'tab-audit';
        layoutEl.classList.toggle('inv-active', isInv);
        window.scrollTo({ top: 0 });
        if (isInv) renderInventoryTab(tabId);
      }

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { switchTab(btn.getAttribute('data-tab')); });
      });

      /* ---------- Inventory rendering ---------- */
      var invDataEl = document.getElementById('inventoryData');
      var invData = {};
      if (invDataEl) { try { invData = JSON.parse(invDataEl.textContent); } catch(e) {} }

      function escHtml(s) {
        if (s == null) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(String(s)));
        return d.innerHTML;
      }
      function escAttr(s) {
        /* Escape a value for safe use inside HTML attributes (class names, etc.).
           Strips everything except alphanumerics, hyphens, and underscores. */
        if (s == null) return '';
        return String(s).replace(/[^a-zA-Z0-9_-]/g, '');
      }

      function statusBanner(status, details) {
        return '<div class="inv-status-banner inv-status-banner--' + escAttr(status) + '">' + escHtml(details) + '</div>';
      }

      function metricCard(label, value, variant) {
        var cls = variant ? ' card--' + escAttr(variant) : '';
        var valCls = variant ? ' style="color:var(--color-' + escAttr(variant) + ')"' : '';
        return '<div class="card' + cls + '"><div class="value"' + valCls + '>' + escHtml(value) + '</div><div class="label">' + escHtml(label) + '</div></div>';
      }

      function remediationBlock(text) {
        if (!text) return '';
        return '<div class="inv-remediation"><strong>Remediation</strong>' + escHtml(text) + '</div>';
      }

      function renderInventoryTab(tabId) {
        if (renderedTabs[tabId]) return;
        renderedTabs[tabId] = true;
        var container = document.querySelector('#' + tabId + ' .inv-main');
        if (!container) return;

        var renderers = {
          'tab-inv-groups': function() { return renderGroupsTab(invData['ADD-28']); },
          'tab-inv-chat': function() { return renderChatTab(invData['ADD-29']); },
          'tab-inv-mobile': function() { return renderMobileTab(invData['ADD-30']); },
          'tab-inv-chromeos': function() { return renderChromeOSTab(invData['ADD-31']); },
          'tab-inv-2sv': function() { return render2SVTab(invData['ADD-32']); },
          'tab-inv-oauth': function() { return renderOAuthTab(invData['ADD-33']); },
          'tab-inv-asps': function() { return renderASPsTab(invData['ADD-34']); },
          'tab-inv-drives': function() { return renderSharedDrivesTab(invData['ADD-35']); }
        };
        var fn = renderers[tabId];
        if (fn) {
          container.innerHTML = fn();
          if (tabId === 'tab-inv-oauth') attachOAuthSearch();
        }
      }

      /* -- Groups (ADD-28) -- */
      function renderGroupsTab(d) {
        if (!d) return '<p>No data available.</p>';
        var raw = d.raw_data || {};
        var empty = raw.empty_groups || [];
        var inactive = raw.all_inactive_groups || [];
        var total = raw.total_analyzed || 0;
        var html = '<h2>Stale Groups</h2>';
        html += statusBanner(d.status, d.details);
        html += '<div class="inv-metrics">';
        html += metricCard('Total Groups', total, 'total');
        html += metricCard('Empty Groups', empty.length, empty.length > 0 ? 'warn' : 'pass');
        html += metricCard('All-Inactive', inactive.length, inactive.length > 0 ? 'warn' : 'pass');
        html += '</div>';
        if (empty.length > 0) {
          html += '<div class="inv-table-wrap"><h3>Empty Groups</h3><table><thead><tr><th>#</th><th>Group Email</th></tr></thead><tbody>';
          for (var i = 0; i < empty.length; i++) {
            html += '<tr><td>' + (i+1) + '</td><td>' + escHtml(empty[i]) + '</td></tr>';
          }
          html += '</tbody></table></div>';
        }
        if (inactive.length > 0) {
          html += '<div class="inv-table-wrap"><h3>Groups With Only Inactive Members</h3><table><thead><tr><th>#</th><th>Group Email</th></tr></thead><tbody>';
          for (var j = 0; j < inactive.length; j++) {
            html += '<tr><td>' + (j+1) + '</td><td>' + escHtml(inactive[j]) + '</td></tr>';
          }
          html += '</tbody></table></div>';
        }
        html += remediationBlock(d.remediation);
        return html;
      }

