      /* -- 2SV Enrollment (ADD-32) -- */
      function render2SVTab(d) {
        if (!d) return '<p>No data available.</p>';
        var raw = d.raw_data || {};
        var summary = raw.summary || {};
        var perOU = raw.per_ou || [];
        var html = '<h2>2-Step Verification Enrollment</h2>';
        html += statusBanner(d.status, d.details);
        html += '<div class="inv-metrics">';
        html += metricCard('Total Users', summary.total_users || 0, 'total');
        html += metricCard('Enrolled', summary.enrolled || 0, 'pass');
        html += metricCard('Not Enrolled', summary.not_enrolled || 0, (summary.not_enrolled || 0) > 0 ? 'fail' : 'pass');
        html += metricCard('Enrollment Rate', summary.enrollment_rate || '0%', 'rate');
        html += '</div>';
        if (perOU.length > 0) {
          html += '<div class="inv-table-wrap"><table><thead><tr><th>Org Unit</th><th>Total</th><th>Enrolled</th><th>Not Enrolled</th><th>Rate</th><th>Details</th></tr></thead><tbody>';
          for (var i = 0; i < perOU.length; i++) {
            var ou = perOU[i];
            var rate = ou.total > 0 ? (ou.enrolled / ou.total * 100) : 0;
            var barColor = rate >= 90 ? 'var(--color-pass)' : rate >= 70 ? 'var(--color-warn)' : 'var(--color-fail)';
            var users = ou.users_without_2sv || [];
            html += '<tr><td><strong>' + escHtml(ou.org_unit) + '</strong></td>';
            html += '<td>' + ou.total + '</td>';
            html += '<td>' + ou.enrolled + '</td>';
            html += '<td>' + ou.not_enrolled + '</td>';
            html += '<td><span class="progress-bar"><span class="progress-bar__fill" style="width:' + rate.toFixed(1) + '%;background:' + barColor + '"></span></span>' + escHtml(ou.enrollment_rate) + '</td>';
            html += '<td>';
            if (users.length > 0) {
              var uid = 'ou-users-' + i;
              html += '<button class="inv-expand-btn" onclick="var el=document.getElementById(\'' + uid + '\');el.classList.toggle(\'open\');this.textContent=el.classList.contains(\'open\')?\'\u25B2 Hide\':\'\u25BC ' + users.length + ' user(s)\'">\u25BC ' + users.length + ' user(s)</button>';
              html += '<div class="inv-user-list" id="' + uid + '">';
              for (var j = 0; j < users.length; j++) {
                html += escHtml(users[j]) + '<br>';
              }
              html += '</div>';
            } else {
              html += '<span style="color:var(--color-pass)">All enrolled</span>';
            }
            html += '</td></tr>';
          }
          html += '</tbody></table></div>';
        }
        html += remediationBlock(d.remediation);
        return html;
      }

      /* -- OAuth Risk (ADD-33) -- */
      function renderOAuthTab(d) {
        if (!d) return '<p>No data available.</p>';
        var raw = d.raw_data || {};
        var apps = raw.dangerous_apps || {};
        var totalGrants = raw.total_grants || 0;
        var appKeys = Object.keys(apps);

        /* Categorize apps by scope type */
        var SCOPE_CATEGORIES = [
          { key: 'gmail', label: 'Full Gmail Access', pattern: 'mail.google.com', desc: 'These apps can read, send, and delete ALL emails. This is the most dangerous Gmail scope.' },
          { key: 'gmail_modify', label: 'Gmail Modify Access', pattern: 'gmail.modify', desc: 'These apps can modify, label, and delete emails. Nearly as dangerous as full Gmail access.' },
          { key: 'drive', label: 'Full Drive Access', pattern: '/auth/drive', desc: 'These apps have access to ALL files in Drive, including shared drives. Apps should use drive.file instead.' },
          { key: 'admin', label: 'Admin Directory Access', pattern: 'admin.directory', desc: 'These apps can read or modify user accounts, groups, and organizational units.' },
          { key: 'cloud', label: 'Cloud Platform Access', pattern: 'cloud-platform', desc: 'These apps have full access to Google Cloud resources — the broadest possible scope.' },
          { key: 'calendar', label: 'Calendar Access', pattern: '/auth/calendar', desc: 'These apps can read, create, and delete calendar events across all calendars.' },
          { key: 'contacts', label: 'Contacts Access', pattern: '/auth/contacts', desc: 'These apps have full access to the user\'s contacts.' },
          { key: 'other', label: 'Other Dangerous Scopes', pattern: null, desc: 'Apps with other dangerous scope grants (spreadsheets, documents, etc.).' }
        ];

        /* Group apps into categories */
        var categorized = {};
        for (var c = 0; c < SCOPE_CATEGORIES.length; c++) {
          categorized[SCOPE_CATEGORIES[c].key] = [];
        }
        for (var i = 0; i < appKeys.length; i++) {
          var app = apps[appKeys[i]];
          var placed = false;
          var appScopes = app.dangerous_scopes || [];
          for (var c = 0; c < SCOPE_CATEGORIES.length - 1; c++) {
            var pat = SCOPE_CATEGORIES[c].pattern;
            for (var si = 0; si < appScopes.length; si++) {
              if (appScopes[si].indexOf(pat) !== -1) {
                categorized[SCOPE_CATEGORIES[c].key].push(app);
                placed = true;
                break;
              }
            }
          }
          if (!placed) {
            categorized['other'].push(app);
          }
        }

        /* Count by risk level */
        var criticalCount = 0, highCount = 0, mediumCount = 0;
        for (var i = 0; i < appKeys.length; i++) {
          var rl = apps[appKeys[i]].risk_level;
          if (rl === 'CRITICAL') criticalCount++;
          else if (rl === 'HIGH') highCount++;
          else mediumCount++;
        }

        /* Count category totals for metrics */
        var gmailFull = categorized['gmail'].length;
        var driveFull = categorized['drive'].length;
        var adminCount = categorized['admin'].length;

        var html = '<h2>OAuth Risk Analysis</h2>';
        html += statusBanner(d.status, d.details);

        /* -- Metric cards -- */
        html += '<div class="inv-metrics">';
        html += metricCard('Total Grants', totalGrants, 'total');
        html += metricCard('Dangerous Apps', appKeys.length, appKeys.length > 0 ? 'fail' : 'pass');
        html += metricCard('Critical', criticalCount, criticalCount > 0 ? 'fail' : 'pass');
        html += metricCard('High', highCount, highCount > 0 ? 'warn' : 'pass');
        html += metricCard('Full Gmail', gmailFull, gmailFull > 0 ? 'fail' : 'pass');
        html += metricCard('Full Drive', driveFull, driveFull > 0 ? 'fail' : 'pass');
        html += '</div>';

        if (appKeys.length === 0) {
          html += remediationBlock(d.remediation);
          return html;
        }

        /* -- Email search -- */
        html += '<div class="oauth-search-box">';
        html += '<span class="search-label">Search by email:</span>';
        html += '<input type="text" id="oauthEmailSearch" placeholder="Filter by user email\u2026">';
        html += '<span class="result-count" id="oauthSearchCount"></span>';
        html += '</div>';

        /* -- Risk Distribution table -- */
        html += '<div class="oauth-risk-table"><table><thead><tr><th>Risk Level</th><th>Category</th><th>Count</th><th>Description</th></tr></thead><tbody>';
        for (var c = 0; c < SCOPE_CATEGORIES.length; c++) {
          var cat = SCOPE_CATEGORIES[c];
          var count = categorized[cat.key].length;
          if (count === 0) continue;
          var maxRisk = 'MEDIUM';
          for (var j = 0; j < categorized[cat.key].length; j++) {
            var r = categorized[cat.key][j].risk_level;
            if (r === 'CRITICAL') { maxRisk = 'CRITICAL'; break; }
            if (r === 'HIGH') maxRisk = 'HIGH';
          }
          html += '<tr><td><span class="risk-badge risk-badge--' + maxRisk + '">' + maxRisk + '</span></td>';
          html += '<td>' + escHtml(cat.label) + '</td>';
          html += '<td><strong>' + count + '</strong></td>';
          html += '<td>' + escHtml(cat.desc) + '</td></tr>';
        }
        html += '</tbody></table></div>';

        /* -- Scope explanation box -- */
        html += '<div class="scope-explanation"><h4>Understanding Dangerous OAuth Scopes</h4>';
        html += '<p><strong>Most Dangerous Scopes:</strong></p><ul>';
        html += '<li><code>https://mail.google.com/</code> \u2014 FULL access to Gmail (read, send, delete)</li>';
        html += '<li><code>https://www.googleapis.com/auth/drive</code> \u2014 FULL access to all Drive files</li>';
        html += '<li><code>https://www.googleapis.com/auth/admin.directory.user</code> \u2014 Manage user accounts</li>';
        html += '<li><code>https://www.googleapis.com/auth/cloud-platform</code> \u2014 Full Google Cloud access</li>';
        html += '<li><code>https://www.googleapis.com/auth/gmail.modify</code> \u2014 Modify all emails</li>';
        html += '</ul></div>';

        /* -- Per-category sections -- */
        for (var c = 0; c < SCOPE_CATEGORIES.length; c++) {
          var cat = SCOPE_CATEGORIES[c];
          var catApps = categorized[cat.key];
          if (catApps.length === 0) continue;

          /* Sort: CRITICAL first, then HIGH, then MEDIUM, then by grant_count desc */
          catApps.sort(function(a, b) {
            var ro = { CRITICAL: 0, HIGH: 1, MEDIUM: 2 };
            var ra = ro[a.risk_level] !== undefined ? ro[a.risk_level] : 3;
            var rb = ro[b.risk_level] !== undefined ? ro[b.risk_level] : 3;
            if (ra !== rb) return ra - rb;
            return (b.grant_count || 0) - (a.grant_count || 0);
          });

          html += '<div class="oauth-section" data-category="' + cat.key + '">';
          html += '<div class="oauth-section-header"><h3>' + escHtml(cat.label) + ' (' + catApps.length + ' apps)</h3>';
          html += '<p class="scope-desc">' + escHtml(cat.desc) + '</p></div>';
          html += '<table><thead><tr><th>App Name</th><th>Client ID</th><th>Risk</th><th>Dangerous Scopes</th><th>Granted By</th><th>Grants</th></tr></thead><tbody>';

          for (var j = 0; j < catApps.length; j++) {
            var app = catApps[j];
            var riskCls = 'risk-badge risk-badge--' + escAttr(app.risk_level || 'HIGH');
            var scopeTags = (app.dangerous_scopes || []).map(function(s) {
              var short = s.replace('https://www.googleapis.com/auth/', '').replace('https://', '');
              return '<span class="scope-tag">' + escHtml(short) + '</span>';
            }).join(' ');
            var emails = (app.granted_by || []).map(escHtml);
            var SHOW_LIMIT = 3;
            var emailsHtml;
            if (emails.length <= SHOW_LIMIT) {
              emailsHtml = emails.join(', ');
            } else {
              var uid = 'oauth-users-' + cat.key + '-' + j;
              emailsHtml = emails.slice(0, SHOW_LIMIT).join(', ');
              emailsHtml += '<button class="inv-expand-btn" onclick="var el=document.getElementById(\'' + uid + '\');el.classList.toggle(\'open\');this.textContent=el.classList.contains(\'open\')?\'\u25B2 Hide\':\'+ ' + (emails.length - SHOW_LIMIT) + ' more\'">';
              emailsHtml += '+ ' + (emails.length - SHOW_LIMIT) + ' more</button>';
              emailsHtml += '<div class="inv-user-list" id="' + uid + '">' + emails.slice(SHOW_LIMIT).join(', ') + '</div>';
            }

            html += '<tr class="oauth-app-row" data-emails="' + emails.join(',').toLowerCase() + '">';
            html += '<td class="col-app"><strong>' + escHtml(app.app_name) + '</strong></td>';
            html += '<td class="col-id" title="' + escHtml(app.client_id) + '"><code>' + escHtml(app.client_id) + '</code></td>';
            html += '<td><span class="' + riskCls + '">' + escHtml(app.risk_level) + '</span></td>';
            html += '<td class="col-scopes">' + scopeTags + '</td>';
            html += '<td class="col-users">' + emailsHtml + '</td>';
            html += '<td>' + (app.grant_count || 0) + '</td></tr>';
          }
          html += '</tbody></table></div>';
        }

        html += remediationBlock(d.remediation);
        return html;
      }

      /* -- App Passwords (ADD-34) -- */
      function renderASPsTab(d) {
        if (!d) return '<p>No data available.</p>';
        var raw = d.raw_data || {};
        var totalAsps = raw.total_asps || 0;
        var usersWithAsps = raw.users_with_asps || 0;
        var neverUsed = raw.never_used_asps || 0;
        var aspsByUser = raw.asps_by_user || [];
        var html = '<h2>App-Specific Passwords</h2>';
        html += statusBanner(d.status, d.details);
        html += '<div class="inv-metrics">';
        html += metricCard('Total ASPs', totalAsps, totalAsps > 0 ? 'fail' : 'pass');
        html += metricCard('Users With ASPs', usersWithAsps, usersWithAsps > 0 ? 'fail' : 'pass');
        html += metricCard('Never Used', neverUsed, neverUsed > 0 ? 'warn' : 'pass');
        html += '</div>';
        if (aspsByUser.length > 0) {
          html += '<div class="inv-table-wrap"><table><thead><tr><th>#</th><th>User</th><th>Password Name</th><th>Created</th><th>Last Used</th></tr></thead><tbody>';
          var idx = 0;
          for (var i = 0; i < aspsByUser.length; i++) {
            var entry = aspsByUser[i];
            var asps = entry.asps || [];
            for (var j = 0; j < asps.length; j++) {
              idx++;
              var neverCls = asps[j].last_used === 'Never' ? ' style="color:var(--color-warn)"' : '';
              html += '<tr><td>' + idx + '</td><td>' + escHtml(entry.user) + '</td><td>' + escHtml(asps[j].name) + '</td><td>' + escHtml(asps[j].created) + '</td><td' + neverCls + '>' + escHtml(asps[j].last_used) + '</td></tr>';
            }
          }
          html += '</tbody></table></div>';
        }
        html += remediationBlock(d.remediation);
        return html;
      }

      /* -- Shared Drives (ADD-35) -- */
      function renderSharedDrivesTab(d) {
        if (!d) return '<p>No data available.</p>';
        var raw = d.raw_data || {};
        var totalDrives = raw.total_drives || 0;
        var insecureDrives = raw.insecure_drives || 0;
        var drives = raw.drives || [];
        var html = '<h2>Shared Drives Security</h2>';
        html += statusBanner(d.status, d.details);
        html += '<div class="inv-metrics">';
        html += metricCard('Total Drives', totalDrives, 'total');
        html += metricCard('Insecure Drives', insecureDrives, insecureDrives > 0 ? 'fail' : 'pass');
        html += '</div>';
        if (drives.length > 0) {
          html += '<div class="inv-table-wrap"><table><thead><tr><th>#</th><th>Name</th><th>Domain Only</th><th>Members Only</th><th>Admin Managed</th><th>Sharing Req Org</th><th>Issues</th></tr></thead><tbody>';
          for (var i = 0; i < drives.length; i++) {
            var drv = drives[i];
            var issues = (drv.issues || []).join(', ') || 'None';
            var rowCls = drv.issues && drv.issues.length > 0 ? ' class="row-fail"' : '';
            html += '<tr' + rowCls + '><td>' + (i+1) + '</td>';
            html += '<td>' + escHtml(drv.name) + '</td>';
            html += '<td style="color:' + (drv.domain_users_only ? 'var(--color-pass)' : 'var(--color-fail)') + '">' + (drv.domain_users_only ? 'Yes' : 'No') + '</td>';
            html += '<td style="color:' + (drv.drive_members_only ? 'var(--color-pass)' : 'var(--color-fail)') + '">' + (drv.drive_members_only ? 'Yes' : 'No') + '</td>';
            html += '<td style="color:' + (drv.admin_managed ? 'var(--color-pass)' : 'var(--color-fail)') + '">' + (drv.admin_managed ? 'Yes' : 'No') + '</td>';
            html += '<td style="color:' + (drv.sharing_requires_organizer ? 'var(--color-pass)' : 'var(--color-fail)') + '">' + (drv.sharing_requires_organizer ? 'Yes' : 'No') + '</td>';
            html += '<td>' + escHtml(issues) + '</td></tr>';
          }
          html += '</tbody></table></div>';
        }
        html += remediationBlock(d.remediation);
        return html;
      }

      /* Email search handler for OAuth tab — attached after first render */
      function attachOAuthSearch() {
        var input = document.getElementById('oauthEmailSearch');
        var countEl = document.getElementById('oauthSearchCount');
        if (!input) return;
        input.addEventListener('input', function() {
          var q = input.value.trim().toLowerCase();
          var rows = document.querySelectorAll('.oauth-app-row');
          var shown = 0, total = rows.length;
          for (var i = 0; i < rows.length; i++) {
            var emails = rows[i].getAttribute('data-emails') || '';
            var match = !q || emails.indexOf(q) !== -1;
            rows[i].style.display = match ? '' : 'none';
            if (match) shown++;
          }
          /* Hide sections where all rows hidden */
          var sections = document.querySelectorAll('.oauth-section');
          for (var s = 0; s < sections.length; s++) {
            var sRows = sections[s].querySelectorAll('.oauth-app-row');
            var anyVisible = false;
            for (var r = 0; r < sRows.length; r++) {
              if (sRows[r].style.display !== 'none') { anyVisible = true; break; }
            }
            sections[s].style.display = anyVisible ? '' : 'none';
          }
          countEl.textContent = q ? (shown + ' of ' + total + ' apps') : '';
        });
      }

      /* ---------- Print support: render all inventory tabs before printing ---------- */
      window.addEventListener('beforeprint', function() {
        var tabs = ['tab-inv-groups','tab-inv-chat','tab-inv-mobile','tab-inv-chromeos','tab-inv-2sv','tab-inv-oauth','tab-inv-asps','tab-inv-drives'];
        for (var i = 0; i < tabs.length; i++) {
          renderInventoryTab(tabs[i]);
        }
      });

      /* ---------- Detail modal ---------- */
      var modal = document.getElementById('detailModal');
      var modalClose = document.getElementById('modalClose');

      function openModal(row) {
        document.getElementById('modal-check-id').textContent = row.getAttribute('data-check-id') || '';
        var src = row.getAttribute('data-source') || '';
        var srcEl = document.getElementById('modal-source');
        srcEl.textContent = src;
        srcEl.className = 'source-tag source-tag--' + src;
        document.getElementById('modal-title').textContent = row.getAttribute('data-title') || '';
        var status = row.getAttribute('data-status') || '';
        document.getElementById('modal-status-wrap').innerHTML = '<strong>Status:</strong> <span class="badge badge--' + escAttr(status) + '">' + escHtml(status.replace('_', ' ')) + '</span>';
        document.getElementById('modal-level').textContent = row.getAttribute('data-level') || '';
        document.getElementById('modal-section').textContent = row.getAttribute('data-section') || '';
        document.getElementById('modal-details').textContent = row.getAttribute('data-details') || '';
        document.getElementById('modal-actual').textContent = row.getAttribute('data-actual') || 'N/A';
        document.getElementById('modal-expected').textContent = row.getAttribute('data-expected') || 'N/A';
        document.getElementById('modal-org-unit').textContent = row.getAttribute('data-org-unit') || '/';
        document.getElementById('modal-remediation').textContent = row.getAttribute('data-remediation') || 'None';
        modal.classList.add('visible');
      }

      function closeModal() { modal.classList.remove('visible'); }
      modalClose.addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

      document.querySelectorAll('.check-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('a')) return;
          openModal(row);
        });
      });

      /* ---------- Back to top ---------- */
      var backBtn = document.getElementById('backToTop');
      window.addEventListener('scroll', function() {
        backBtn.classList.toggle('visible', window.scrollY > 400);
      });
      backBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

    })();
  </script>

</body>
</html>
