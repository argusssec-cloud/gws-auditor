        if (spaces.length > 0) {
          html += '<div class="inv-table-wrap"><table><thead><tr><th>#</th><th>Space Name</th><th>Space ID</th><th>Last Active</th></tr></thead><tbody>';
          for (var i = 0; i < spaces.length; i++) {
            var s = spaces[i];
            html += '<tr><td>' + (i+1) + '</td><td>' + escHtml(s.name) + '</td><td><code>' + escHtml(s.space_id) + '</code></td><td>' + escHtml(s.last_active) + '</td></tr>';
          }
          html += '</tbody></table></div>';
