auth:
  method: service_account  # or oauth
  credentials_file: credentials.json
  subject: admin@example.com  # delegated admin email
  customer_id: my_customer

checks:
  levels: [L1, L2]           # or just [L1]
  sources: [CIS, OTHER, GOOGLE, CISA]
  sections: all               # or list specific sections
  exclude: []                 # exclude specific check IDs

output:
  directory: ./reports
  formats: [html, json, csv]

options:
  cache_data: true            # cache API responses
  cache_directory: ./cache
  org_units: all              # or list specific OUs
  max_retries: 5
  rate_limit_qps: 10

  # Drive trust rules (Admin console > Drive and Docs > Trust rules) are not
  # exposed by any read API. Export them to a JSON array and point at the file
  # here; CIS-3.1.2.1.1.1 and CIS-3.1.2.1.1.2 then credit an OU whose sharing
  # is governed by an active BLOCK_SHARE rule instead of failing it.
  # trust_rules_file: ./trust_rules.json

  # OU paths (or fnmatch patterns) whose permissive external sharing is
  # deliberate. Matching OUs downgrade an otherwise-FAIL sharing check to
  # PARTIAL rather than hiding it. Leave empty to use the built-in patterns
  # (*External*, *Contractors*, *Vendors*, *Third*Part*, ...).
  # external_sharing_ous:
  #   - /Acme/Sharing-External
  #   - "*Partners*"

ai:
  provider: openai              # openai, anthropic, or bedrock
  model: ""                     # blank = provider default
  api_key: ""                   # prefer env var OPENAI_API_KEY / ANTHROPIC_API_KEY
  temperature: 0.1
  max_tokens: 4096
  business_context: ""          # e.g. "500-person healthcare company, HIPAA required"
  # aws_region: us-east-1       # bedrock only
  # aws_profile: ""             # bedrock only
  # base_url: ""                # OpenAI-compatible endpoint override
